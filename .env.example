# Quran Quiz Platform — environment template.
# Copy to .env.local and fill in. All NEXT_PUBLIC_* values are browser-visible
# (publishable/anon credentials only — never service-role keys).

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Storage bucket for avatars & quiz covers (created by the Phase 4 migration)
NEXT_PUBLIC_SUPABASE_BUCKET=media

# --- Supabase server-only (never NEXT_PUBLIC_) ---
# Needed by /api/auth/register to set app_metadata.role at signup, and by
# /api/auth/phone/check to start a session once Bird has verified the number.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Bird Verify: sign-in codes by SMS (server-only, never NEXT_PUBLIC_) ---
# A live Bird access key with the verify scope. The key's own prefix
# (bk_{region}_...) carries the region and the workspace, so there is no
# workspace id, no channel id and no base URL to set: Verify sends over the
# workspace's SMS channel (the Bird Shared Pool unless you registered a sender).
# Without this, phone sign-in is refused and the screen says so; email still works.
BIRD_API_KEY=
# Only for a key minted before the bk_{region}_ prefix existed, e.g. "eu1".
BIRD_REGION=
# Which channels Verify may use, in order. Leave EMPTY so Bird uses the plan it
# has for the destination country and can fall back when one channel fails —
# pinning it to a single channel also removes the failover, which is how a code
# ends up accepted and never delivered. Set "sms" only if SMS and nothing else
# is acceptable.
VERIFY_CHANNELS=

# --- Voice/camera calls: TURN relay (server-only, never NEXT_PUBLIC_) ---
# Without any of these the call falls back to a free public relay, which works
# but is best effort. Set ONE provider; /api/turn mints the browser credentials
# so the API key below never reaches the client.
#
# Cloudflare Realtime TURN (free tier):
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Twilio Network Traversal Service (pay as you go):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Self-hosted coturn or any static-credential TURN:
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Legacy external REST backend — being retired, do not use ---
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_DB_TABLE=