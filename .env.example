# Quran Quiz Platform — environment template.
# Copy to .env.local and fill in. All NEXT_PUBLIC_* values are browser-visible
# (publishable/anon credentials only — never service-role keys).

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Storage bucket for avatars & quiz covers (created by the Phase 4 migration)
NEXT_PUBLIC_SUPABASE_BUCKET=media

# --- Legacy external REST backend — being retired, do not use ---
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_DB_TABLE=